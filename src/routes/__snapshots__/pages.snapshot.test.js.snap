// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`rendered pages > about renders unchanged 1`] = `"<!--[--><section class="sec about-hero svelte-cwls5q"><div class="wrap split about-split svelte-cwls5q"><div class="reveal"><div class="eyebrow">About Vinya</div> <h1 class="svelte-cwls5q">A space with room to breathe.</h1> <p class="lede" style="font-size:var(--text-lg);line-height:1.75;color:var(--brown-700);margin-top:34px">Vinya is a yoga inspired initiative in the Netherlands. Most people who find us are somewhere in the middle of: a change, a tiredness, a hesitation they can’t name or ready to step out of their comfort zone. Either you’re ready to work on your physical and mental state.</p> <!--[--><p style="font-size:var(--text-base);line-height:1.9;color:var(--text-secondary);margin-top:26px">The practice sits in two places at once: The physical and the mental. Breathe is rarely just breathe. It’s the beginning of changing the narrative. Using it as a tool to control our mind, so we are choosing who we become.</p><p style="font-size:var(--text-base);line-height:1.9;color:var(--text-secondary);margin-top:22px">Vinya is just creating a space for you to make space for yourself.</p><!--]--></div> <div class="media reveal svelte-cwls5q"><div class="photo svelte-1q8sh7o tunable" style="--fx:50%;--fy:52%;--z:1;--fx-m:50%;--fy-m:60%;--z-m:1"><picture><!--[-1--><!--]--> <img src="/images/vinya-studio-b.jpeg" alt="An evening kirtan in the hall, musicians on the low stage under warm lights" loading="lazy" fetchpriority="auto" decoding="async" draggable="false" class="svelte-1q8sh7o"/></picture> <!--[-1--><!--]--> <!--[-1--><!--]--></div><!----></div></div></section> <section class="sec sunken"><div class="wrap"><div class="sec-head reveal" style="text-align:center;margin-left:auto;margin-right:auto"><div class="eyebrow">What to expect</div> <h2 style="margin-top:18px">How the room is held.</h2></div> <div class="triptych quad svelte-cwls5q"><div class="t reveal"><div class="h">How we teach</div><p>Personal attention is our non negotiable. There are hands-on adjustments and deepening, if consent has been given.</p></div> <div class="t reveal"><div class="h">Who it’s for</div><p>Complete beginners, and regulars who want to deepen their practice.</p></div> <div class="t reveal"><div class="h">Training</div><p>Teaching hours and certifications, to be confirmed and listed here.</p></div> <div class="t reveal"><div class="h">Beyond class</div><p>1:1 holistic sessions, private groups, and retreats a few times a year.</p></div></div> <div class="reveal" style="margin-top:56px;display:flex;gap:14px;flex-wrap:wrap;justify-content:center"><button class="btn btn-primary">Book a 1:1 session</button> <a class="btn btn-secondary" href="/classes">See the timetable</a></div></div></section> <section class="sec"><div class="wrap split founder svelte-cwls5q" style="align-items:start"><div class="media reveal svelte-cwls5q"><div class="photo svelte-1q8sh7o tunable" style="--fx:50%;--fy:20%;--z:1;--fx-m:50%;--fy-m:20%;--z-m:1"><picture><!--[0--><source type="image/webp" srcset="/images/nikita-standing-1400.webp 1400w, /images/nikita-standing-2200.webp 2200w" sizes="(max-width:820px) 100vw, 46vw"/><!--]--> <img src="/images/nikita-standing-2200.jpg" srcset="/images/nikita-standing-1400.jpg 1400w, /images/nikita-standing-2200.jpg 2200w" sizes="(max-width:820px) 100vw, 46vw" alt="Nikita Coppens standing in natural light" loading="lazy" fetchpriority="auto" decoding="async" draggable="false" class="svelte-1q8sh7o"/></picture> <!--[-1--><!--]--> <!--[-1--><!--]--></div><!----></div> <div class="reveal"><div class="eyebrow">About the founder</div> <h2 style="margin-top:22px">Nikita Coppens</h2> <div class="role svelte-cwls5q">Founder · Yoga, breathwork and Kirtan</div> <p class="lede" style="margin-top:28px">Before starting Vinya, Nikita has been studying different forms of yoga in India, exploring the body, movement, breath and the connection between physical and mental wellbeing. After her studies, she travelled to Sri Lanka, where she taught yoga and continued to deepen her experience of working with the body.</p> <p style="margin-top:22px">Before starting Vinya, Nikita has been studying different forms of yoga in India, exploring the body, movement, breath and the connection between physical and mental wellbeing. After her studies, she travelled to Sri Lanka, where she taught yoga and continued to deepen her experience of working with the body.</p> <p style="margin-top:22px">Originally from Amsterdam, Nikita now lives and works there, bringing these different experiences together through Vinya. Through yoga, movement, breath and sound, she creates spaces where people can reconnect with their bodies and create more space for healing, awareness and connection.</p> <div style="margin-top:36px"><a class="tlink" href="/teachers">Meet the teachers <span>→</span></a></div></div></div></section> <section class="sec sunken" id="find-us"><div class="wrap wrap-narrow" style="text-align:center"><div class="divider reveal"><div class="line"></div><span class="lbl">Find us</span><div class="line"></div></div> <h2 class="reveal" style="font-size:var(--text-3xl);color:var(--brown-700);margin-top:48px">Where we practice.</h2> <p class="reveal" style="font-size:var(--text-base);line-height:1.85;color:var(--text-secondary);margin:22px auto 0;max-width:52ch">Classes are held at partner studios around the city. Every class on the timetable says where it meets.</p> <div class="venues svelte-cwls5q"><!--[--><div class="venue reveal svelte-cwls5q"><div class="venue-copy svelte-cwls5q"><div class="k svelte-cwls5q">Tru Colours</div> <p class="svelte-cwls5q">Geschutswerf 12-14, 1018 BX Amsterdam</p> <a class="tlink" href="https://www.google.com/maps/search/?api=1&amp;query=Tru%20Colours%20Geschutswerf%2012-14%2C%201018%20BX%20Amsterdam" target="_blank" rel="noopener noreferrer">Open in maps <span>→</span></a></div> <div class="venue-map svelte-cwls5q"><iframe src="https://www.google.com/maps?q=Tru%20Colours%20Geschutswerf%2012-14%2C%201018%20BX%20Amsterdam&amp;output=embed" title="Map showing Tru Colours, Geschutswerf 12-14, 1018 BX Amsterdam" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="svelte-cwls5q"></iframe></div></div><!--]--></div></div></section><!--]-->"`;

exports[`rendered pages > classes renders unchanged 1`] = `"<!--[--><section><div class="wrap phead"><div class="lead-row"><div><div class="eyebrow">Classes</div><h1>A week with room in it.</h1></div> <p>Classes facilitated in different studios. Book the class you need. No membership, no pressure to keep a streak.</p></div></div></section> <section class="sec" style="padding-top:clamp(56px,7vh,80px)"><div class="wrap"><div class="class-list"><!--[--><div class="class-row reveal"><div class="lead"><div class="tone tan"></div><h3>Kundalini Yoga</h3><div class="meta">60 min · All levels · Mat provided</div></div> <button class="row-trigger"><span class="row-trigger-txt">Tru Colours · Geschutswerf 12-14, 1018 BX Amsterdam</span> <span class="tap-cue">Details <span class="arrow">→</span></span></button> <button class="btn btn-secondary">Book Kundalini Yoga</button></div><div class="class-row reveal"><div class="lead"><div class="tone sky"></div><h3>Slow Yoga Adjustment</h3><div class="meta">60 min · All levels · Hands-on adjustment</div></div> <button class="row-trigger"><span class="row-trigger-txt">Tru Colours · Geschutswerf 12-14, 1018 BX Amsterdam</span> <span class="tap-cue">Details <span class="arrow">→</span></span></button> <button class="btn btn-secondary">Book Slow Yoga Adjustment</button></div><!--]--></div></div></section> <section class="sec sunken"><div class="wrap"><div class="sec-head row" style="margin-bottom:44px"><div><div class="eyebrow">Weekly rhythm</div><h2 style="margin-top:16px">The timetable</h2></div> <span style="font-size:var(--text-sm);color:var(--text-muted)">Tap a session to book</span></div> <div><!--[--><div class="tt-row"><div class="day">Tuesday</div> <div class="tt-slots"><!--[--><div class="slot"><button class="row-trigger"><span class="row-trigger-txt"><strong>10:30</strong> · Kundalini Yoga · 60 min</span> <span class="tap-cue">Details <span class="arrow">→</span></span></button> <button class="btn btn-primary sm">Book</button></div><!--]--></div></div><div class="tt-row"><div class="day">Sunday</div> <div class="tt-slots"><!--[--><div class="slot"><button class="row-trigger"><span class="row-trigger-txt"><strong>12:45</strong> · Slow Yoga Adjustment · 60 min</span> <span class="tap-cue">Details <span class="arrow">→</span></span></button> <button class="btn btn-primary sm">Book</button></div><!--]--></div></div><!--]--></div></div></section> <section class="sec" id="prices"><div class="wrap"><div class="sec-head reveal"><div class="eyebrow">Passes &amp; prices</div><h2 style="margin-top:18px">Pay for the week you need.</h2></div> <div class="prices"><!--[--><button class="price  reveal"><span class="lbl">Drop-in</span><span class="amt">€15</span><span class="note">One class, whenever it suits.</span> <span class="tap-cue">Pay €15 <span class="arrow">→</span></span></button><button class="price  reveal"><span class="lbl">5-class pass</span><span class="amt">€50</span><span class="note">Valid three months. No rush.</span> <span class="tap-cue">Pay €50 <span class="arrow">→</span></span></button><button class="price feature reveal"><span class="lbl">10-class pass</span><span class="amt">€90</span><span class="note">Valid six months. Most people land here.</span> <span class="tap-cue">Pay €90 <span class="arrow">→</span></span></button><button class="price  reveal"><span class="lbl">1:1 session</span><span class="amt">€60</span><span class="note">75 min, yoga or holistic.</span> <span class="tap-cue">Pay €60 <span class="arrow">→</span></span></button><!--]--></div> <p class="prices-note">Paying a pass and booking a class are separate — pay whenever suits, book when you know the date.</p></div></section> <section class="sec sunken"><div class="wrap"><div class="sec-head reveal"><div class="eyebrow">Our offerings</div><h2 style="margin-top:18px">Beyond the weekly mat.</h2></div> <!--[--><div class="offer-cat"><h3>Weekly</h3><div class="line"></div></div> <div class="offer-list"><!--[--><div class="offer-row reveal"><div><h4>Multi-Style Yoga Classes</h4><p>A rotating mix of styles across the week, beyond the set timetable.</p></div> <button class="btn btn-secondary">Enquire</button></div><div class="offer-row reveal"><div><h4>Pre &amp; Post Natal Yoga</h4><p>Gentle, safe practice through pregnancy and after.</p></div> <button class="btn btn-secondary">Enquire</button></div><!--]--></div><div class="offer-cat"><h3>Monthly</h3><div class="line"></div></div> <div class="offer-list"><!--[--><div class="offer-row reveal"><div><h4>Community Yoga &amp; Brunch</h4><p>Practice together, then stay for food.</p></div> <button class="btn btn-secondary">Enquire</button></div><div class="offer-row reveal"><div><h4>Social Events</h4><p>Gatherings beyond the mat.</p></div> <button class="btn btn-secondary">Enquire</button></div><!--]--></div><div class="offer-cat"><h3>Private</h3><div class="line"></div></div> <div class="offer-list"><!--[--><div class="offer-row reveal"><div><h4>Birthday Celebration</h4><p>Yoga as part of the celebration, wherever you are hosting.</p></div> <button class="btn btn-secondary">Enquire</button></div><div class="offer-row reveal"><div><h4>Friend Gathering</h4><p>A private class with your own group.</p></div> <button class="btn btn-secondary">Enquire</button></div><div class="offer-row reveal"><div><h4>1:1 Sessions</h4><p>One on one, yoga or holistic.</p></div> <button class="btn btn-secondary">Enquire</button></div><!--]--></div><div class="offer-cat"><h3>Corporate Teambuilding</h3><div class="line"></div></div> <div class="offer-list"><!--[--><div class="offer-row reveal"><div><h4>Yoga, Soundhealing &amp; Brunch</h4><p>A team morning off-site, on the mat and around the table.</p></div> <button class="btn btn-secondary">Enquire</button></div><!--]--></div><!--]--></div></section> <section class="sec" id="faq"><div class="wrap wrap-narrow"><div class="sec-head reveal"><div class="eyebrow">First time?</div><h2 style="margin-top:18px">Everything you're quietly wondering</h2></div> <div class="faq"><!--[--><details><summary>I've never done yoga. Is that really okay?<span class="pm">+</span></summary> <p>Yes, and you won't be the only one. Kundalini Yoga and Slow Yoga Adjustment are both built for a first class. Tell us when you arrive and your teacher will keep an eye on you without making it obvious.</p></details><details><summary>What should I bring?<span class="pm">+</span></summary> <p>Comfortable clothes, water, and socks if you get cold. Mats, bolsters and blankets are here. Bring your own mat if you would rather.</p></details><details><summary>How early should I arrive?<span class="pm">+</span></summary> <p>Ten minutes is plenty. Doors close at the start time so the room stays quiet. If you are running late, message us and we will let you in between sections.</p></details><details><summary>Do I need to book in advance?<span class="pm">+</span></summary> <p>Please do, groups are small and classes fill. Book through the form on this site and you will get a confirmation by email.</p></details><details><summary>What if I need to cancel?<span class="pm">+</span></summary> <p>Cancel up to 12 hours before and the class goes back on your pass. Life happens later than that sometimes, so just tell us. (Policy to confirm.)</p></details><!--]--></div></div></section><!--]-->"`;

exports[`rendered pages > events renders unchanged 1`] = `"<!--[--><section><div class="wrap phead"><div class="eyebrow">Events</div> <h1>Gatherings, month by month.</h1> <p>Workshops, full-moon flows, sound baths and the occasional day retreat. Each one is its own thing, with its own place and price.</p></div></section> <section class="sec" style="padding-top:clamp(40px,5vh,64px)"><div class="wrap"><!--[--><div class="ev-head"><h2>August 2026</h2><div class="line"></div><span class="n">2 gatherings</span></div> <!--[--><div class="ev reveal"><div class="cal"><div class="d">08</div><div class="w">Sat</div></div> <div class="info"><h3>Full Moon Flow &amp; Sound Bath</h3><div class="det">19:00 · 90 min · €28 · Location to confirm</div><p>Slow flow as the light goes, then bowls and voice to close. Bring something warm to lie under.</p></div> <div class="act"><button class="btn btn-primary">Reserve</button> <span class="rem">6 places left</span></div></div><div class="ev reveal"><div class="cal"><div class="d">23</div><div class="w">Sun</div></div> <div class="info"><h3>Bloom Slowly: a workshop for beginners</h3><div class="det">10:00 · 3 hours · €45 · Tea included</div><p>Three unhurried hours on breath, the six shapes worth knowing, and a home practice that survives a normal week.</p></div> <div class="act"><button class="btn btn-primary">Reserve</button> <span class="rem">10 places</span></div></div><!--]--><div class="ev-head"><h2>September 2026</h2><div class="line"></div><span class="n">2 gatherings</span></div> <!--[--><div class="ev reveal"><div class="cal"><div class="d">05</div><div class="w">Sat</div></div> <div class="info"><h3>Sunrise Rooftop Flow</h3><div class="det">07:30 · 60 min · €22 · Rooftop, to confirm</div><p>Outdoors, weather permitting. Coffee afterwards for anyone who wants to stay.</p></div> <div class="act"><button class="btn btn-primary">Reserve</button> <span class="rem">Weather dependent</span></div></div><div class="ev reveal"><div class="cal"><div class="d">26</div><div class="w">Sat</div></div> <div class="info"><h3>Breath &amp; Body: a day retreat</h3><div class="det">09:30 to 16:00 · €95 · Lunch included</div><p>Two practices, a long lunch, and holistic bodywork in between. Eight people only.</p></div> <div class="act"><button class="btn btn-primary">Reserve</button> <span class="rem">8 places</span></div></div><!--]--><!--]--></div> <div class="wrap"><button class="archive-toggle"><span class="lbl">Past gatherings</span><span class="line"></span><span class="a">Show 3</span></button> <div class="archive"><div class="arch-row"><span class="dt">26 Jul</span><span class="nm">Breathwork Circle</span><span class="st">Full</span></div> <div class="arch-row"><span class="dt">12 Jul</span><span class="nm">Solstice Slow Flow</span><span class="st">Full</span></div> <div class="arch-row"><span class="dt">14 Jun</span><span class="nm">Bloom Series I · three evenings</span><span class="st">Ran twice</span></div></div></div></section><!--]-->"`;

exports[`rendered pages > footer renders unchanged 1`] = `"<!--[--><footer><div class="wrap foot-grid"><div><div class="foot-brand"><img src="/logos/vinya-logo-cream.png" alt="Vinya"/></div> <p>Breathe. Connect. Bloom.</p></div> <div class="foot-col"><div class="h">Site</div> <a href="/">Home</a><a href="/classes">Classes</a><a href="/teachers">Teachers</a><a href="/events">Events</a><a href="/about">About</a></div> <div class="foot-col"><div class="h">Practical</div> <a href="/classes#faq">First-timer FAQ</a><a href="/classes#prices">Passes &amp; prices</a><a href="/about#find-us">Find us</a></div> <div class="foot-col"><div class="h">Stay close</div> <p style="max-width:32ch">A quiet note when a new month of events opens. Nothing else.</p> <div class="sub"><input placeholder="you@email.com" aria-label="Email" value=""/> <button class="btn btn-primary sm">Join</button></div> <p style="font-size:12px;color:var(--tan-400);margin-top:14px"></p></div></div> <div class="wrap foot-bottom"><span>© 2026 Vinya Yoga</span></div></footer><!--]-->"`;

exports[`rendered pages > home renders unchanged 1`] = `"<!--[--><section class="hero"><div class="hero-copy"><div class="hero-copy-inner"><img class="hero-logo" src="/logos/vinya-logo-brown.png" alt="Vinya — Breathe, Connect, Bloom"/> <h1>Breathe through the hesitation. Bloom into who you already are.</h1> <div class="hero-cta"><button class="btn btn-primary lg">Book a class</button> <a class="btn btn-ghost lg" href="/events">See what's coming</a></div></div></div> <svg class="hero-seam-h" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true"><defs><clipPath id="vine-h-a" clipPathUnits="userSpaceOnUse"><rect class="vine-wipe h" x="-20" y="-20" width="1040" height="240"></rect></clipPath><clipPath id="vine-h-b" clipPathUnits="userSpaceOnUse"><rect class="vine-wipe h b" x="-20" y="-20" width="1040" height="240"></rect></clipPath></defs><path class="seam-fill" d="M0,0 L0,150 C62,176 188,176 250,150 C312,124 438,124 500,150 C562,176 688,176 750,150 C812,124 938,124 1000,150 L1000,0 Z"></path><path class="strand a" clip-path="url(#vine-h-a)" vector-effect="non-scaling-stroke" d="M-4,98 C62,144 188,144 250,98 C312,92 438,92 500,98 C562,144 688,144 750,98 C812,92 938,92 1004,98"></path><path class="strand b" clip-path="url(#vine-h-b)" vector-effect="non-scaling-stroke" d="M-4,98 C62,104 188,104 250,98 C312,52 438,52 500,98 C562,104 688,104 750,98 C812,52 938,52 1004,98"></path></svg> <div class="hero-media"><div class="photo svelte-1q8sh7o tunable" style="--fx:50%;--fy:78%;--z:1;--fx-m:50%;--fy-m:76%;--z-m:1"><picture><!--[0--><source type="image/webp" srcset="/images/nikita-form-1400.webp 1400w, /images/nikita-form-2200.webp 2200w" sizes="(max-width:820px) 100vw, 50vw"/><!--]--> <img src="/images/nikita-form-2200.jpg" srcset="/images/nikita-form-1400.jpg 1400w, /images/nikita-form-2200.jpg 2200w" sizes="(max-width:820px) 100vw, 50vw" alt="Nikita in a seated backbend on a wooden deck, surrounded by palms" loading="eager" fetchpriority="high" decoding="async" draggable="false" class="svelte-1q8sh7o"/></picture> <!--[-1--><!--]--> <!--[-1--><!--]--></div><!----></div> <svg class="hero-seam" viewBox="0 0 200 1000" preserveAspectRatio="none" aria-hidden="true"><defs><clipPath id="vine-v-a" clipPathUnits="userSpaceOnUse"><rect class="vine-wipe" x="-20" y="-20" width="240" height="1040"></rect></clipPath><clipPath id="vine-v-b" clipPathUnits="userSpaceOnUse"><rect class="vine-wipe b" x="-20" y="-20" width="240" height="1040"></rect></clipPath></defs><path class="seam-fill" d="M0,0 L150,0 C176,62 176,188 150,250 C124,312 124,438 150,500 C176,562 176,688 150,750 C124,812 124,938 150,1000 L0,1000 Z"></path><path class="strand a" clip-path="url(#vine-v-a)" vector-effect="non-scaling-stroke" d="M114,-4 C156,62 156,188 114,250 C104,312 104,438 114,500 C156,562 156,688 114,750 C104,812 104,938 114,1004"></path><path class="strand b" clip-path="url(#vine-v-b)" vector-effect="non-scaling-stroke" d="M114,-4 C124,62 124,188 114,250 C72,312 72,438 114,500 C124,562 124,688 114,750 C72,812 72,938 114,1004"></path></svg></section> <div class="marquee" aria-hidden="true"><div class="marquee-track"><!--[--><div class="seq"><!--[--><span>Breathe</span><span class="dot">·</span> <span>Connect</span><span class="dot">·</span> <span>Bloom</span><span class="dot">·</span> <span class="brandword">Vinya</span><span class="dot">·</span><span>Breathe</span><span class="dot">·</span> <span>Connect</span><span class="dot">·</span> <span>Bloom</span><span class="dot">·</span> <span class="brandword">Vinya</span><span class="dot">·</span><span>Breathe</span><span class="dot">·</span> <span>Connect</span><span class="dot">·</span> <span>Bloom</span><span class="dot">·</span> <span class="brandword">Vinya</span><span class="dot">·</span><!--]--></div><div class="seq"><!--[--><span>Breathe</span><span class="dot">·</span> <span>Connect</span><span class="dot">·</span> <span>Bloom</span><span class="dot">·</span> <span class="brandword">Vinya</span><span class="dot">·</span><span>Breathe</span><span class="dot">·</span> <span>Connect</span><span class="dot">·</span> <span>Bloom</span><span class="dot">·</span> <span class="brandword">Vinya</span><span class="dot">·</span><span>Breathe</span><span class="dot">·</span> <span>Connect</span><span class="dot">·</span> <span>Bloom</span><span class="dot">·</span> <span class="brandword">Vinya</span><span class="dot">·</span><!--]--></div><!--]--></div></div> <section class="sec"><div class="wrap"><div class="sec-head row reveal"><div><div class="eyebrow">The practice</div><h2>Schedule for this week</h2></div> <a class="tlink" href="/classes">See the full timetable <span>→</span></a></div> <div class="practice-grid"><!--[--><div class="practice reveal"><div class="tone tan"></div> <h3>Kundalini Yoga</h3> <div class="meta">60 min · All levels · Mat provided</div> <p>Breath, mantra and movement built in kriyas that rise slowly, then let go.</p> <button class="tlink">Book a place <span>→</span></button></div><div class="practice reveal"><div class="tone sky"></div> <h3>Slow Yoga Adjustment</h3> <div class="meta">60 min · All levels · Hands-on adjustment</div> <p>Slow shapes, held long, with hands-on adjustment so you feel exactly where you hold on.</p> <button class="tlink">Book a place <span>→</span></button></div><!--]--></div></div></section> <section class="sec sunken"><div class="wrap split wide"><div class="media reveal"><div class="photo svelte-1q8sh7o tunable" style="--fx:50%;--fy:50%;--z:1;--fx-m:50%;--fy-m:50%;--z-m:1"><picture><!--[-1--><!--]--> <img src="/images/vinya-studio-a.jpeg" alt="A kirtan circle seated on cushions in a garden, harmonium at the centre" loading="lazy" fetchpriority="auto" decoding="async" draggable="false" class="svelte-1q8sh7o"/></picture> <!--[-1--><!--]--> <!--[-1--><!--]--></div><!----></div> <div class="reveal"><div class="eyebrow">About Vinya</div> <h2 style="margin-top:22px">A space with room to breathe.</h2> <p class="lede" style="margin-top:26px">Vinya is a yoga inspired initiative in the Netherlands. Most people who find us are somewhere in the middle of: a change, a tiredness, a hesitation they can't name or ready to step out of their comfort zone. Either you're ready to work on your physical and mental state.</p> <div style="margin-top:36px"><a class="tlink" href="/about">More about Vinya <span>→</span></a></div></div></div></section> <section class="sec"><div class="wrap triptych"><div class="t reveal"><div class="h">Breathe</div><p>Breathe is the bridge between who you are guarded and who you are open. We start there, every time.</p></div> <div class="t reveal"><div class="h">Connect</div><p>Moving together creates connection together. Come for the practice, stay for the connection.</p></div> <div class="t reveal"><div class="h">Bloom</div><p>Come as you are today, not as the version you think is ready.</p></div></div></section> <section class="sec sunken"><div class="wrap split"><div class="reveal" style="order:1"><div class="eyebrow">Your teachers</div> <h2 style="margin-top:22px">Held by people who came to yoga the long way around.</h2> <div style="margin-top:36px;display:flex;gap:14px;flex-wrap:wrap"><a class="btn btn-primary" href="/teachers">Meet the teachers</a> <a class="btn btn-secondary" href="/classes">Explore our offerings</a></div></div> <div class="media arch reveal" style="order:2"><div class="photo svelte-1q8sh7o tunable" style="--fx:50%;--fy:45%;--z:1;--fx-m:50%;--fy-m:45%;--z-m:1"><picture><!--[-1--><!--]--> <img src="/images/nikita-practice.JPG" alt="Nikita sounding a singing bowl over someone resting in savasana" loading="lazy" fetchpriority="auto" decoding="async" draggable="false" class="svelte-1q8sh7o"/></picture> <!--[-1--><!--]--> <!--[-1--><!--]--></div><!----></div></div></section> <section class="sec espresso"><div class="wrap event-band"><div class="date-chip reveal"><div class="d">08</div><div class="m">Aug</div></div> <div class="reveal"><div class="eyebrow gold" style="color:var(--gold-500)">Next gathering</div> <h2 style="margin-top:14px">Full Moon Flow &amp; Sound Bath</h2> <p>Saturday 19:00 · 90 minutes · €28 · Location to be confirmed. Slow flow as the light goes, then sound to close.</p></div> <div class="reveal" style="display:flex;flex-direction:column;gap:14px"><button class="btn btn-primary lg">Reserve your place</button> <a style="font-size:var(--text-sm);color:var(--tan-300);text-align:center;letter-spacing:.06em" href="/events">All events</a></div></div></section> <section class="sec"><div class="wrap"><div class="sec-head reveal"><div class="eyebrow">In their words</div><h2 style="margin-top:18px">Quietly, people keep coming back.</h2></div> <div class="quotes"><div class="quote reveal"><p>"I came in stiff and a little cynical. I left breathing differently. The room is so quiet you can actually hear yourself soften."</p><div class="who">Marieke · Slow Yoga Adjustment</div></div> <div class="quote reveal"><p>"First yoga in my life at 43. Nobody made me feel behind. I've been back every week since."</p><div class="who">Tomas · Beginners course</div></div> <div class="quote reveal"><p>"The 1:1 sessions with Nikita did more for my sleep than anything else this year. Gentle, and exactly what I needed."</p><div class="who">Sanne · 1:1 Holistic</div></div></div> <div class="rating reveal"><span class="stars">★★★★★</span><span>Loved by a small, growing circle · real reviews to be gathered here</span></div></div></section> <section class="sec sunken"><div class="wrap"><div class="divider reveal"><div class="line"></div><span class="lbl">In this together</span><div class="line"></div></div> <blockquote class="blockquote-lg reveal" style="margin-top:56px">Leave a little more room to bloom.</blockquote> <div class="gallery" style="margin-top:64px"><div class="g reveal"><div class="photo svelte-1q8sh7o tunable" style="--fx:50%;--fy:50%;--z:1;--fx-m:50%;--fy-m:50%;--z-m:1"><picture><!--[-1--><!--]--> <img src="/images/vinya-studio-a.jpeg" alt="A kirtan circle seated on cushions in a garden, harmonium at the centre" loading="lazy" fetchpriority="auto" decoding="async" draggable="false" class="svelte-1q8sh7o"/></picture> <!--[-1--><!--]--> <!--[-1--><!--]--></div><!----></div> <div class="g arch reveal"><div class="photo svelte-1q8sh7o tunable" style="--fx:50%;--fy:45%;--z:1;--fx-m:50%;--fy-m:45%;--z-m:1"><picture><!--[-1--><!--]--> <img src="/images/nikita-practice.JPG" alt="Nikita sounding a singing bowl over someone resting in savasana" loading="lazy" fetchpriority="auto" decoding="async" draggable="false" class="svelte-1q8sh7o"/></picture> <!--[-1--><!--]--> <!--[-1--><!--]--></div><!----></div> <div class="g reveal"><div class="photo svelte-1q8sh7o tunable" style="--fx:50%;--fy:52%;--z:1;--fx-m:50%;--fy-m:52%;--z-m:1"><picture><!--[-1--><!--]--> <img src="/images/vinya-studio-b.jpeg" alt="An evening kirtan in the hall, musicians on the low stage under warm lights" loading="lazy" fetchpriority="auto" decoding="async" draggable="false" class="svelte-1q8sh7o"/></picture> <!--[-1--><!--]--> <!--[-1--><!--]--></div><!----></div></div></div></section>  <section class="sec" id="partners"><div class="wrap"><div class="divider reveal"><div class="line"></div><span class="lbl">Partners &amp; Facilitators</span><div class="line"></div></div> <!--[-1--><div class="partners reveal"><!--[--><!--[0--><a class="partner-logo" href="https://classpass.com/" target="_blank" rel="noopener noreferrer" aria-label="ClassPass" style="--logo-h: 68px;"><img src="/partner-logos/classpass-logo.svg" alt="ClassPass" loading="lazy"/> <span class="tip">ClassPass</span></a><!--]--><!--[0--><a class="partner-logo" href="https://urbansportsclub.com/en/" target="_blank" rel="noopener noreferrer" aria-label="Urban Sports Club" style="--logo-h: 72px;"><img src="/partner-logos/urbansportsclub-logo.webp" alt="Urban Sports Club" loading="lazy"/> <span class="tip">Urban Sports Club</span></a><!--]--><!--[-1--><button type="button" class="partner-logo" aria-label="Tru Colours" style="--logo-h: 104px;"><img src="/partner-logos/trucolours.webp" alt="Tru Colours" loading="lazy"/> <span class="tip">Tru Colours</span></button><!--]--><!--]--></div><!--]--></div></section> <section class="sec sunken"><div class="wrap"><div class="eyebrow reveal" style="margin-bottom:12px">Where to next</div> <div class="jump reveal"><a href="/classes"><span>Find a class for you</span><span class="arrow">→</span></a> <a href="/events"><span>Workshops &amp; gatherings</span><span class="arrow">→</span></a> <a href="/classes#prices"><span>Passes &amp; prices</span><span class="arrow">→</span></a> <a href="/teachers"><span>Meet your teachers</span><span class="arrow">→</span></a></div></div></section><!--]-->"`;

exports[`rendered pages > teachers renders unchanged 1`] = `"<!--[--><section><div class="wrap phead" style="padding-top:clamp(32px,5vh,56px);text-align:center"><div class="eyebrow">Who we are</div> <h1 style="margin:14px auto 0">Meet our teachers.</h1></div></section> <section class="sec" style="padding-top:clamp(20px,3vh,36px)"><div class="wrap"><div class="teacher-carousel"><!--[-1--><!--]--> <!----><div class="teacher-card reveal in"><div class="portrait"><div class="photo svelte-1q8sh7o tunable" style="--fx:50%;--fy:20%;--z:1;--fx-m:50%;--fy-m:20%;--z-m:1"><picture><!--[0--><source type="image/webp" srcset="/images/nikita-standing-1400.webp 1400w, /images/nikita-standing-2200.webp 2200w" sizes="(max-width:820px) 100vw, 40vw"/><!--]--> <img src="/images/nikita-standing-2200.jpg" srcset="/images/nikita-standing-1400.jpg 1400w, /images/nikita-standing-2200.jpg 2200w" sizes="(max-width:820px) 100vw, 40vw" alt="Nikita Coppens standing in natural light" loading="lazy" fetchpriority="auto" decoding="async" draggable="false" class="svelte-1q8sh7o"/></picture> <!--[-1--><!--]--> <!--[-1--><!--]--></div><!----></div> <div class="info"><h2>Nikita Coppens</h2> <div class="role">Yoga teacher · Holistic therapeut</div> <p class="intro-lede">Nikita came to yoga the long way around, through years of care work, and it shows in how she holds a room. Patient, attuned, and unhurried.</p> <ul class="highlight-list"><!--[--><li>Originally from the Netherlands</li><li>Teaches yoga, breathwork, and Kirtan</li><li>Also offers 1:1 holistic sessions</li><li>Background in Dutch mental-health care (GGZ)</li><li>Studied yoga, sound healing and alternative medicine in India</li><!--]--></ul> <div class="intro-cta"><button class="btn btn-primary">Book a 1:1 with Nikita</button> <a class="btn btn-secondary" href="/classes">See the timetable</a></div></div></div><!----> <!--[-1--><!--]--></div> <!--[-1--><!--]--></div></section> <section class="sec sunken"><div class="wrap"><div class="sec-head reveal" style="text-align:center;margin-left:auto;margin-right:auto"><div class="eyebrow">How Vinya teachers work</div><h2 style="margin-top:18px">Care first, always.</h2></div> <div class="spec-grid"><div class="spec reveal"><h4>How we teach</h4><p>Patient and attuned. We meet you where you are today, offering an invitation as clearly as an instruction.</p></div> <div class="spec reveal"><h4>Care background</h4><p>Years in Dutch mental-health care (GGZ) as a personal support worker, and training as an addiction counsellor.</p></div> <div class="spec reveal"><h4>Studied in India</h4><p>Yoga, sound healing and alternative medicine, where our view of health widened to body and mind as one.</p></div> <div class="spec reveal"><h4>Beyond class</h4><p>1:1 holistic sessions and community sound-healing gatherings, built around not standing alone.</p></div></div> <div class="reveal" style="margin-top:52px;display:flex;gap:14px;flex-wrap:wrap;justify-content:center"><button class="btn btn-primary">Book a 1:1 session</button> <a class="btn btn-secondary" href="/classes">See the timetable</a></div></div></section> <section class="sec"><div class="wrap wrap-narrow" style="text-align:center"><div class="divider reveal"><div class="line"></div><span class="lbl">Growing the circle</span><div class="line"></div></div> <blockquote class="blockquote-lg reveal" style="margin-top:48px;max-width:24ch">Room for more teachers, when the right ones arrive.</blockquote> <p class="reveal" style="font-size:var(--text-base);line-height:1.85;color:var(--text-secondary);margin:28px auto 0;max-width:52ch">Vinya is always open for collaboration. As guest teachers and workshop leaders join, they'll be introduced here, each with their own way of holding the room.</p> <div class="reveal" style="margin-top:36px"><button class="btn btn-secondary">Get in touch about teaching</button></div></div></section><!--]-->"`;
