# Copy to .env and fill in. See README "Booking email" for where each value comes from.
#
# Everything here is PRIVATE except the PUBLIC_ pair: variables without the
# PUBLIC_ prefix are only readable by server code and never reach the browser.
# Do not add PUBLIC_ to any of the mail settings.

# --- Booking email (required for the booking form to work) ---

# SMTP for the studio mailbox. Gmail: smtp.gmail.com / 465.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
# A Google *app password*, not the account password. 16 characters, no spaces.
MAIL_PASS=
# Optional. Defaults to MAIL_USER. Set a display name so visitors see "Vinya" in
# their inbox rather than a raw address:  Vinya <vinyayoga@gmail.com>
# Gmail only honours this if the address is the same mailbox as MAIL_USER.
MAIL_FROM=

# Who receives booking requests. Comma-separated, all get a copy.
# Required even with MAIL_DEV_ECHO=1: the booking endpoint refuses to send a
# request that has no recipient, rather than reporting a success nobody got.
# Any address works for a local echo test.
MAIL_TO=owner@example.com
# Optional, also comma-separated.
MAIL_CC=

# Signs the confirmation codes. Generate with:  openssl rand -base64 32
# Changing it invalidates any code already in flight, which is harmless.
OTP_SECRET=anything-at-all-for-now

# Local development only: print the code to the terminal instead of emailing it,
# so the flow can be tested without SMTP. Ignored in production builds.
MAIL_DEV_ECHO=1

# --- Newsletter (optional) ---
# Leave blank to run the newsletter signup in prototype mode.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
